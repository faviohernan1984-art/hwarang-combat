rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Local emulator rules only. Server endpoints use Admin SDK.
    match /matches/{matchId} {
      allow read, write: if true;
      match /{document=**} {
        allow read, write: if true;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
